{
  "name": "cwv-optimizator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "pipeline": "node --import tsx src/main.ts",
    "gui": "node --import tsx src/gui/main.ts",
    "check": "tsc --noEmit && tsc --noEmit -p src/gui/web/tsconfig.json",
    "test": "vitest run --dir tests",
    "format": "prettier --write src tests website.config.example.ts package.json tsconfig.json eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --check src tests website.config.example.ts package.json tsconfig.json eslint.config.mjs .prettierrc.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "playwright": "1.61.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "lighthouse": "^13.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-vitals": "^6.2.3"
  }
}
